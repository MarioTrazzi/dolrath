# Variáveis do DEPLOY (Hardhat lê só este arquivo — o app usa o .env da raiz).
# Runbooks: REHEARSAL-AMOY.md (ensaio na Amoy) e LAUNCH-MAINNET.md (mainnet).

# RPCs
POLYGON_AMOY_RPC_URL=
POLYGON_MAINNET_RPC_URL=

# Carteira que assina os deploys. Descartável: só precisa de POL para gas.
# NUNCA é a tesouraria e NUNCA se reaproveita entre Amoy e mainnet.
DEPLOYER_PRIVATE_KEY=

# --- Papéis de carteira (endereços PÚBLICOS) ---------------------------------
# Signers = hot wallets do servidor, uma por contrato. São argumentos de
# construtor; podem ser trocados depois via setSigner (só-owner).
NFT_SIGNER_ADDRESS=
GOLD_SIGNER_ADDRESS=
ITEM_NFT_SIGNER_ADDRESS=

# Recebe o 1B de DOL no deploy do DolToken (Fase 2).
DOL_TREASURY_ADDRESS=
# Recebe o GOLD gasto nas compras da loja.
GOLD_TREASURY_ADDRESS=
# Recebe a metade não-queimada da taxa dos markets (4% itens / 5% personagens).
DOL_FEE_TREASURY_ADDRESS=
# Safe multisig que vira dono dos contratos (chain:transfer-ownership).
OWNER_SAFE_ADDRESS=

# --- Endereços deployados ----------------------------------------------------
# Cada script imprime o endereço e o SEGUINTE lê daqui — cole antes do próximo
# passo. Não existe deployments/*.json: este arquivo é o registro.

# ⚠️ Guarda o token de PAGAMENTO da criação de personagem, não o DOL:
#    Amoy = TestUSDC (6 casas), mainnet = USDC nativa da Circle.
#    Só o PAGAMENTO usa esta var. A moeda do mercado de personagens foi
#    separada em CHARACTER_MARKET_PAY_TOKEN_ADDRESS (abaixo).
DOL_TOKEN_ADDRESS=

# 6b. Moeda do MERCADO DE PERSONAGENS — o DolToken de verdade.
#     Separada de DOL_TOKEN_ADDRESS porque no ensaio aquela var guarda o
#     TestUSDC: deployar o mercado contra ele criaria um mercado cobrando dólar
#     de teste, e `dol` é immutable no contrato (só redeploy conserta). Pior, o
#     TestUSDC não tem `burnFrom` e o buy() queima 2,5% — toda compra reverteria.
#     Vazia = cai no fallback DOL_TOKEN_ADDRESS (correto fora do ensaio).
#     deploy-character-market.ts recusa rodar se apontar para USDC_TOKEN_ADDRESS
#     ou para um token sem burnFrom.
CHARACTER_MARKET_PAY_TOKEN_ADDRESS=

GOLD_CONTRACT_ADDRESS=
CHARACTER_NFT_CONTRACT_ADDRESS=
ITEM_NFT_CONTRACT_ADDRESS=
ITEM_MARKET_CONTRACT_ADDRESS=
CHARACTER_MARKET_CONTRACT_ADDRESS=

# baseURI do DolrathItems.tokenURI(). Lido por deploy-items e set-items-baseuri.
# Prod:  https://dolrath.vercel.app/api/nft/item/metadata/
# Local: http://localhost:3000/api/nft/item/metadata/
ITEM_NFT_BASE_URI=

# --- Helpers -----------------------------------------------------------------
# chain:mint:usdc:amoy — carga de tUSDC para estúdio e bots (o faucet público
# do contrato resolve para os testadores).
USDC_TOKEN_ADDRESS=
USDC_MINT_TO=
USDC_MINT_AMOUNT=

# chain:mint — TRANSFERE do supply da tesouraria: o DolToken v2 tem supply fixo
# de 1B cunhado no construtor e não tem função de mint.
DOL_MINT_TO=
DOL_MINT_AMOUNT=
