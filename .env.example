# Neon PostgreSQL Database
DATABASE_URL="sua_connection_string_aqui"

# NextAuth Configuration
NEXTAUTH_URL="https://seu-app.vercel.app"
NEXTAUTH_SECRET="chave_secreta_muito_longa_e_segura_aqui"

# Login é exclusivamente por carteira (SIWE-style). O challenge de login é
# assinado/validado via HMAC com NEXTAUTH_SECRET — nenhuma var extra é necessária.

# Cloudinary (opcional)
# If you store only the publicId in DB (recommended), set CLOUDINARY_CLOUD_NAME.
# Example publicId: dolrath/items/sword_01
CLOUDINARY_CLOUD_NAME=""
# Optional: if you need it on the client for previews
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# ============================================================
# Target chain (client + server)
# The UI (MetaMask network switch, payments, NFT burns) follows this single var.
# Testnet (default): "80002" (Polygon Amoy) · MAINNET: "137" (Polygon)
# For MAINNET also set every *_CHAIN_ID below to "137", point the *_RPC_URL
# vars at a mainnet RPC (or set POLYGON_MAINNET_RPC_URL) and use the mainnet
# contract addresses + fresh signer keys (see web3/README.md deploy checklist).
# ============================================================
NEXT_PUBLIC_CHAIN_ID="80002"

# Canais da comunidade (landing footer). Vazio/omitido = link some do rodapé.
NEXT_PUBLIC_DISCORD_URL=""
NEXT_PUBLIC_TWITTER_URL=""
NEXT_PUBLIC_GITHUB_URL=""

# ---------- Token de PAGAMENTO (ERC-20) ----------
# ⚠️ As vars abaixo se chamam *_DOL por histórico, mas guardam o token com que o
# jogador PAGA — que na mainnet é USDC, não DOL. O dólar sustenta o estúdio; a
# temporada é disputada em DOL (ver SEASON_ENTRY_DOL). Renomear para
# PAYMENT_TOKEN_* fica para depois do lançamento.
#
# MAINNET: USDC NATIVA da Polygon, 6 decimais — conferir no Polygonscan/Circle
#   antes de setar. A bridged USDC.e (0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174)
#   é OUTRO token; não misturar.
#   USDC nativa: 0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359
# Amoy: o TestUSDC do ensaio (6 decimais, faucet público) —
#   `npm run chain:deploy:usdc:amoy`, roteiro em web3/REHEARSAL-AMOY.md.
#
# Nada aqui assume 18 casas: payDol.ts e dolPayments.ts leem decimals() do
# contrato em runtime.
DOL_TOKEN_ADDRESS=""
# Optional: if omitted, the app falls back to POLYGON_AMOY_RPC_URL / POLYGON_MAINNET_RPC_URL
DOL_RPC_URL=""

# Criação de personagem: 2 USDC → tesouraria do estúdio (NFT, imagem por IA,
# infra). Nenhum dólar entra na pool de premiação.
DOL_TREASURY_ADDRESS=""
CHARACTER_CREATION_COST_DOL="2"

# Client-side (optional). Needed only if you want the UI to initiate the ERC-20 transfer.
NEXT_PUBLIC_DOL_TOKEN_ADDRESS=""
NEXT_PUBLIC_DOL_TREASURY_ADDRESS=""
NEXT_PUBLIC_CHARACTER_CREATION_COST_DOL="2"

# Optional timeouts (ms) to avoid hanging on slow RPCs
DOL_RPC_TIMEOUT_MS="10000"
DOL_BALANCE_TIMEOUT_MS="12000"

# Characters NFT (ERC-721)
# Server-only: used to sign the mint intent (do NOT expose this to the client)
NFT_SIGNER_PRIVATE_KEY=""
# On-chain contract (after deploy)
CHARACTER_NFT_CONTRACT_ADDRESS=""
# Defaults to 80002 (Polygon Amoy)
CHARACTER_NFT_CHAIN_ID="80002"
# RPC for on-chain verification (optional; if empty, verification helper may fall back to other RPC envs)
CHARACTER_NFT_RPC_URL=""

# GOLD (ERC-20) optional claim
# Users accrue GOLD off-chain (DB) and can claim on-chain on demand.
GOLD_CONTRACT_ADDRESS=""
GOLD_CHAIN_ID="80002"
# Optional: if omitted, the app falls back to POLYGON_AMOY_RPC_URL / POLYGON_MAINNET_RPC_URL
GOLD_RPC_URL=""
# Treasury address that receives on-chain GOLD payments (optional; if empty, falls back to DOL_TREASURY_ADDRESS)
GOLD_TREASURY_ADDRESS=""
# Server-only: used to sign EIP-712 claim vouchers (do NOT expose this to the client)
GOLD_SIGNER_PRIVATE_KEY=""

# Item NFTs (ERC-721)
ITEM_NFT_CONTRACT_ADDRESS=""
ITEM_NFT_CHAIN_ID="80002"
ITEM_NFT_RPC_URL=""
ITEM_NFT_RPC_TIMEOUT_MS="10000"
# baseURI on-chain dos itens: a metadata é viva via baseURI + tokenId.
# Aponte para a rota dinâmica (com barra final). Setado no deploy do contrato
# (DolrathItems constructor) ou via scripts/set-items-baseuri.ts.
# Ex.: https://SEU_DOMINIO/api/nft/item/metadata/
ITEM_NFT_BASE_URI=""

# Server-only signer for item mint intents
ITEM_NFT_SIGNER_PRIVATE_KEY=""

# Item Marketplace (escrow)
ITEM_MARKET_CONTRACT_ADDRESS=""
ITEM_MARKET_CHAIN_ID="80002"
ITEM_MARKET_RPC_URL=""
ITEM_MARKET_RPC_TIMEOUT_MS="10000"

# Character Marketplace (escrow de NFT de personagem, pago em DOL)
CHARACTER_MARKET_CONTRACT_ADDRESS=""
CHARACTER_MARKET_CHAIN_ID="80002"
CHARACTER_MARKET_RPC_URL=""
CHARACTER_MARKET_RPC_TIMEOUT_MS="10000"
# Optional: claim voucher validity window (seconds)
GOLD_CLAIM_DEADLINE_SECONDS="900"
# Optional timeouts (ms) to avoid hanging on slow RPCs
GOLD_RPC_TIMEOUT_MS="10000"

# Optional: timeout (ms) for fetching GOLD on-chain balance
GOLD_BALANCE_TIMEOUT_MS="12000"

# Optional: retries for confirming GOLD payment tx receipts (useful on unstable testnets)
GOLD_PAYMENT_RECEIPT_RETRIES="6"
GOLD_PAYMENT_RECEIPT_DELAY_MS="1000"

# Seed Endpoint Security
# Usado para autenticar requisições POST para /api/seed (execução de seeds via API)
SEED_SECRET="your-secure-seed-secret-here"

# PvP: socket (Render) → API de rewards (Vercel). Mesmo secret nos dois ambientes.
# APP_URL = URL pública do Next (produção). BATTLE_REWARDS_SECRET = header x-battle-secret.
APP_URL="https://dolrath.vercel.app"
BATTLE_REWARDS_SECRET="generate-a-long-random-secret"

# Frota de bots headless (scripts/bot-fleet-*). Header x-bot-secret nas rotas REST.
BOT_FLEET_SECRET="generate-a-long-random-bot-fleet-secret"
# Admin user ids (comma) para /api/ranking/payout e /admin/season
ADMIN_USER_IDS=""

# ---------- Temporada e pool de premiação (docs/19-seasons) ----------
# A pool é 100% em DOL — NENHUM dólar entra na competição. Este é só o aporte
# opcional extra do estúdio por temporada.
PVP_SEASON_POT_DOL="0"
# Inscrição de um herói na temporada, em DOL. Vale para os dois lados: é o que o
# estúdio aporta quando alguém cria um personagem (do bucket Play & Achieve) e o
# que a inscrição avulsa cobra do jogador. Os dois iguais é o que preserva
# "o 20º recupera o que pagou" (1% do split × 100 inscritos = 1 inscrição).
SEASON_ENTRY_DOL="100"
# Inscrição avulsa exige DOL na carteira, então só abre depois do
# DolDistributor (Fase 2). Na temporada 1 a pool vem só da criação.
SEASON_ENTRY_ENABLED="false"
# Corte da pool desviado para o cofre de torneios. ZERO no lançamento: a
# temporada leva a pool inteira, então o 20º recupera exatamente a inscrição.
TOURNAMENT_CUT_PCT="0"
# Personagem criado nos últimos N dias de uma temporada entra de graça na seguinte.
SEASON_ENTRY_GRACE_DAYS="14"
# Duração da temporada. Marco de encerramento: arma + armadura em TET, resto +15
# (~90-100 dias dedicados — docs/balance-report-launch.md). A temporada 1 roda
# 120 dias porque todo mundo começa do zero (criada pelo seed, não por env).
PVP_SEASON_DAYS="90"
# Entressafra: janela sem placar entre temporadas (pagamento + inscrições).
PVP_OFFSEASON_DAYS="7"
# Piso de lutas ranqueadas na temporada para entrar na premiação.
PVP_PAYOUT_MIN_MATCHES="10"
# Lutas/dia contra o MESMO oponente que ainda pontuam (antifarm de conluio).
PVP_PAIR_DAILY_POINT_CAP="3"
# Segredo do cron de virada de temporada (Vercel manda Authorization: Bearer).
CRON_SECRET="generate-a-long-random-cron-secret"

# Example connection string format for Neon:
# DATABASE_URL="postgresql://username:password@ep-xxx.neon.tech/neondb?sslmode=require"

# Geração de imagem da NFT do personagem (DALL·E 3 via OpenAI)
OPENAI_API_KEY="sk-proj-..."
# OPENAI_IMAGE_MODEL="dall-e-3"   # opcional (default: dall-e-3)
# OPENAI_IMAGE_SIZE="1024x1024"   # opcional (default: 1024x1024)

# Merge inteligente do prompt raça+classe + input do jogador (Claude via Anthropic)
# Sem esta chave, o servidor usa um merge determinístico (mantém o estilo travado).
ANTHROPIC_API_KEY="sk-ant-api03-..."
# ANTHROPIC_MODEL="claude-opus-4-8"   # opcional (default: claude-opus-4-8)
